<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="E-CommerceSuite" parallel="classes" data-provider-thread-count="3">

    <listeners>
        <listener class-name="com.commerce.utilities.RetryTransformer"/>
        <listener class-name="com.commerce.utilities.Listener"/>
    </listeners>

    <test name="E-CommerceTests">
        <classes>
            <class name="EcommerceTestCases.endToEndTestCase"/>
            <class name="EcommerceTestCases.endToEndTestCaseExceldata"/>
        </classes>
    </test>

</suite>
